server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name energy-cost.eu;
    include /config/nginx/ssl.conf;
    client_max_body_size 21M;
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $ec_upstream energy-cost-prd;
    location = /healthz { return 404; }
    location = /healthz.php { return 404; }
    location / {
        proxy_pass http://$ec_upstream:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        # Preserve SWAG's existing real_ip configuration (Cloudflare if applicable).
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 300s;
    }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.energy-cost.eu;
    include /config/nginx/ssl.conf;
    return 301 https://energy-cost.eu$request_uri;
}
server {
    listen 80;
    listen [::]:80;
    server_name energy-cost.eu www.energy-cost.eu;
    return 301 https://energy-cost.eu$request_uri;
}
