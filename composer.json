{
    "name": "rayman223/energy-cost-management",
    "description": "Tracking and estimation of energy costs (electricity, gas and water).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "jumbojett/openid-connect-php": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2.2",
        "phpunit/phpunit": "^13.2"
    },
    "suggest": {
        "ext-intl": "Localized formatting (dates, numbers, currencies) compliant with each locale; otherwise neutral fallback."
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --configuration=phpstan.dist.neon"
    }
}
